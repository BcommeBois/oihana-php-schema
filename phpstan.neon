# Static analysis for the library sources.
#
# The level is a floor, raised one batch at a time as the reported errors get
# fixed — not an aspiration.
#
#   composer phpstan            analyse at the configured level
#   composer phpstan -- -l 7    try a higher level without editing this file

parameters:

    level: 8

    paths:
        - src

    tmpDir: build/phpstan

    ignoreErrors:

        # The rule assumes every `array` is a homogeneous collection and asks what
        # it holds. In this library it is not a collection at all : it is a state.
        #
        # A property declared `null|array|Organization|Person` receives an
        # untyped associative array from an AQL or SQL row, then has it replaced
        # by `new Organization( ... )`. The `array` member exists to let that raw
        # row sit in the property until hydration swaps it — it does not *contain*
        # an Organization, it *is* one, not yet built.
        #
        # So `array<Organization|Person>` would not be a more precise annotation,
        # it would be a false one : nothing in that array is an Organization. The
        # only accurate form, `array<string, mixed>`, says nothing at all. There
        # is no correct annotation to write, which makes this a mismatch between
        # the rule and the design rather than a backlog of missing types — and it
        # accounted for every single one of level 6's findings.
        - identifier: missingType.iterableValue

        # `paths` covers src only, so a trait used solely by the test suite — or
        # exported for consumers of the library and never composed in here — reads
        # as dead. That is a question of API surface, not of static correctness,
        # and it is not one this analysis can answer.
        - identifier: trait.unused
